<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GmpPlatform.Acad</RootNamespace>
    <AssemblyName>GmpPlatform.Acad</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Description>GMP Production Platform — AutoCAD drawing engine (draws a shop ticket into the client seed DWG)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmpPlatform.Core\GmpPlatform.Core.csproj" />
  </ItemGroup>

  <!--
    AutoCAD managed API from Autodesk's reference package, so the engine builds on a machine
    without AutoCAD. 25.0 is the AutoCAD 2025 API; AutoCAD 2026 belongs to the same binary-
    compatible family and loads this build unchanged (AcadRunner.SupportedReleases). AutoCAD
    2027 (package 26.x) targets .NET 10 and needs its own engine build.
    ExcludeAssets="runtime": the host AutoCAD process supplies these assemblies; copying them
    beside the engine would load a second, mismatched copy.
  -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
